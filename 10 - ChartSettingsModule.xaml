<UserControl x:Class="ChartSettingsModule" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><GroupBox Header="Chart Settings" Style="{StaticResource DarkGroupBox}"><StackPanel><ComboBox ItemsSource="{Binding ChartTypes}" SelectedItem="{Binding Settings.Chart.Type}" Style="{StaticResource DarkComboBox}"/><ComboBox ItemsSource="{Binding ZoomBehaviors}" SelectedItem="{Binding Settings.Chart.ZoomBehavior}" Style="{StaticResource DarkComboBox}"/><Slider Minimum="0" Maximum="100" Value="{Binding Settings.Chart.ZoomSpeed}"/><Slider Minimum="0" Maximum="100" Value="{Binding Settings.Chart.ScrollSpeed}"/><TextBox Text="{Binding Settings.Chart.VisibleCandles}" Style="{StaticResource DarkTextBox}"/><CheckBox Content="Auto Fit" IsChecked="{Binding Settings.Chart.AutoFit}" Style="{StaticResource DarkCheckBox}"/></StackPanel></GroupBox></UserControl>